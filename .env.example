# Les variables VITE_ sont publiques et embarquées dans le navigateur.
# Les accès ci-dessous n'ont pas ce préfixe : ils restent dans ce fichier local.
# Laisser vide pour utiliser les données de démonstration locales.
VITE_API_URL=http://localhost:6000/api

# Endpoint public optionnel pour recevoir les Web Vitals en production.
VITE_VITALS_ENDPOINT=

# Accès des comptes seed. Sans préfixe VITE_ : Vite ne les envoie pas au navigateur.
# Mot de passe commun, identique à DEMO_PASSWORD du back.
ACCOUNT_PASSWORD=demo-pass
ACCOUNT_ADMIN_EMAIL=admin@pullup.net
ACCOUNT_BRAND_PRO_EMAIL=marketing@savane.ci
ACCOUNT_BRAND_FREE_EMAIL=contact@lepalmier.ci
ACCOUNT_BRAND_BUSINESS_EMAIL=growth@kalo.ci
ACCOUNT_INFLUENCER_EMAIL=amakouassi@mail.ci

